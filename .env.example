# Copia este archivo a .env y completa los valores. .env nunca se commitea.

# --- Base de datos ---
POSTGRES_USER=tecnoandes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tecnoandes
# 5433, no 5432: evita chocar con un Postgres local/de otro proyecto en el puerto por defecto.
POSTGRES_PORT=5433
# Usada por el backend (fuera de Docker: host=localhost; dentro de Docker: host=db)
DATABASE_URL=postgresql+psycopg://tecnoandes:change-me@localhost:5433/tecnoandes

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# USD por millón de tokens (precios publicados de Anthropic para Haiku 4.5).
ANTHROPIC_INPUT_PRICE_PER_MTOK=1.00
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=5.00

# --- Embeddings ---
# Modelo local multilingüe vía sentence-transformers; no requiere API key.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RERANKER_ENABLED=false

# --- Confianza y enrutamiento (ver docs/ARCHITECTURE.md para el detalle de cada señal) ---
CONFIDENCE_THRESHOLD_LOW=40
CONFIDENCE_THRESHOLD_HIGH=75
# Pesos de las señales (deben sumar 1.0); se documentan como heurística inicial,
# calibrada después con `make eval`.
CONFIDENCE_WEIGHT_RETRIEVAL_SCORE=0.5
CONFIDENCE_WEIGHT_RETRIEVAL_MARGIN=0.15
CONFIDENCE_WEIGHT_SUPPORT=0.35
# Valores de referencia para normalizar retrieval_score/margin (similitud
# coseno cruda de E5 vive en un rango angosto ~0.75-0.90); se recalibran con
# `make eval`.
CONFIDENCE_RETRIEVAL_FLOOR=0.75
CONFIDENCE_RETRIEVAL_CEILING=0.90
CONFIDENCE_MARGIN_CEILING=0.05

# --- Consola de revisión ---
# Auth simple de un solo token para la demo; ver docs/adr para la alternativa de producción.
REVIEW_CONSOLE_TOKEN=change-me-too

# --- App ---
LOG_LEVEL=INFO
BACKEND_PORT=8000
# Orígenes del navegador que pueden llamar /ask (CORS). Separados por coma.
CORS_ORIGINS=http://localhost:3000

# Los frontends (apps/chat, apps/review-console) no leen este archivo —
# Next.js solo carga .env.local dentro de cada app. Ver apps/chat/.env.example.
